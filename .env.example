# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-blog-site

# NextAuth
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Public site URL (used for canonical URLs, sitemap, JSON-LD, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (optional — if unset, submissions are only logged server-side)
CONTACT_EMAIL_TO=you@example.com

# Vercel Blob — required for image uploads (featured image + inline editor
# images). Create a Blob store in your Vercel project (Storage tab) and it
# will inject this automatically in production; for local dev, copy the
# token from that store's settings.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
